---
export interface Props{
    title:string,
    navItems:{
        itemText:string,
        itemLink:string
    }[]
}

const {title, navItems} = Astro.props
---

<nav class="footer-nav space-y-0 md:space-y-6">
    <button class="footer-nav-btn w-full flex justify-between items-center py-3 md:py-0 border-b border-box-border md:border-0 text-left">
        <h2 class="capitalize font-semibold text-heading-1 text-xl">
            {title}
        </h2>
        <svg class="footer-nav-icon w-5 h-5 transition-transform duration-300 md:hidden" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
        </svg>
    </button>
    <ul class="footer-nav-list hidden md:block space-y-3 font-medium text-heading-3 pt-3 md:pt-0">
        {navItems.map((navItem)=>(
            <li>
                <a href={navItem.itemLink} class="transition hover:text-primary text-sm">
                    {navItem.itemText}
                </a>
            </li>
        ))}
    </ul>
</nav>

<script>
    const navBtns = document.querySelectorAll('.footer-nav-btn');
    navBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
            const list = btn.nextElementSibling;
            const icon = btn.querySelector('.footer-nav-icon');
            const isOpen = !list.classList.contains('hidden');
            if (isOpen) {
                list.classList.add('hidden');
                icon.classList.remove('rotate-180');
            } else {
                list.classList.remove('hidden');
                icon.classList.add('rotate-180');
            }
        });
    });
</script>