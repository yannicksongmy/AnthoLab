---
import Container from "../shared/Container.astro";
import Title from "../shared/Title.astro";
import Paragraph from "../shared/Paragraph.astro";
import { translations } from "../../i18n";

const { lang = "en" } = Astro.props;
const t = translations[lang];
const base = import.meta.env.BASE_URL;
---

<section id="privacy">
  <Container className="space-y-10 md:space-y-12">
    <div class="text-center max-w-3xl mx-auto space-y-4">
      <Title>{t.privacy.title}</Title>
      <Paragraph>{t.privacy.subtitle}</Paragraph>
    </div>

    <div class="max-w-3xl mx-auto divide-y divide-box-border">
      {t.privacy.sections.map((section) => (
        <div class="flex flex-col gap-3 py-8">
          <div class="flex items-center gap-3">
            <span class="w-1 h-7 rounded-full bg-primary flex-shrink-0"></span>
            <h2 class="text-xl font-semibold text-heading-1">{section.title}</h2>
          </div>
          <p class="text-sm text-heading-3 pl-4">{section.content}</p>
        </div>
      ))}
    </div>
  </Container>
</section>