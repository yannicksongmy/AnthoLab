---
import Container from "../shared/Container.astro";
import Paragraph from "../shared/Paragraph.astro";
import Title from "../shared/Title.astro";
import Button from "../shared/Button.astro";
import { translations } from "../../i18n";

const { lang = "en" } = Astro.props;
const t = translations[lang];

---
<section class="pt-0 pb-0"> 
<div class="mx-auto text-center max-w-screen-lg relative">
  <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold text-heading-1 leading-tight">
    {t.features.text}
  </h1>
</div>
</section>
<section  id="contact" class="pb-0">
  <Container>
    <div
      class="w-full relative py-8 md:py-10 px-6 md:px-8 rounded-2xl bg-gradient-to-tr from-gray-100 to-gray-200 dark:from-gray-900 dark:to-transparent"
    >
    <div class="absolute right-0 top-0 h-full w-full flex justify-end pointer-events-none">
        <div class="w-28 h-28 overflow-auto flex rounded-xl relative blur-2xl">
            <span
              class="absolute w-16 h-16 -top-1 -right-1 bg-green-500 rounded-md rotate-45"
            ></span>
            <span
              class="absolute w-16 h-16 -bottom-1 -right-1 bg-[#FCDC58] rounded-md rotate-45"
            ></span>
            <span
              class="absolute w-16 h-16 -bottom-1 -left-1 bg-primary rounded-md rotate-45"
            ></span>
          </div>
      </div>

      <div class="absolute left-0 bottom-0 h-full w-full flex items-end pointer-events-none">
        <div class="w-28 h-28 overflow-auto flex rounded-xl relative blur-2xl">
            <span
              class="absolute w-16 h-16 -top-1 -right-1 bg-green-500 rounded-md rotate-45"
            ></span>
            <span
              class="absolute w-16 h-16 -bottom-1 -right-1 bg-[#FCDC58] rounded-md rotate-45"
            ></span>
            <span
              class="absolute w-16 h-16 -bottom-1 -left-1 bg-primary rounded-md rotate-45"
            ></span>
          </div>
      </div>
    <div class="text-center max-w-3xl mx-auto space-y-4">
        <Title>
            {t.features.title}
        </Title>
    </div>
    <div class="mx-auto max-w-md sm:max-w-xl pt-10">
  <form
    class="space-y-4 text-left relative z-10 space-y-4 text-left""
    action="mailto:yannicksongmy@gmail.com"
    method="POST"
    enctype="text/plain"
  >

    <!-- NAME -->
    <div class="flex items-center gap-3 px-4 py-3 rounded-full border
                border-gray-300 bg-white text-black
                dark:bg-black dark:text-white dark:border-gray-700">

      <svg xmlns="http://www.w3.org/2000/svg"
        class="w-5 h-5 text-gray-500 dark:text-gray-300"
        fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
          d="M15.75 6.75a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.5 20.25a7.5 7.5 0 0115 0" />
      </svg>

      <input
        type="text"
        name="name"
        placeholder={t.features.form.nom}
        class="w-full bg-transparent outline-none text-sm text-black dark:text-white placeholder-gray-400"
        required
      />
    </div>

    <!-- EMAIL -->
    <div class="flex items-center gap-3 px-4 py-3 rounded-full border
                border-gray-300 bg-white text-black
                dark:bg-black dark:text-white dark:border-gray-700">

      <svg xmlns="http://www.w3.org/2000/svg"
        class="w-5 h-5 text-gray-500 dark:text-gray-300"
        fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
          d="M21.75 9v.906a2.25 2.25 0 01-1.183 1.981l-6.478 3.488a2.25 2.25 0 01-2.134 0L5.477 11.887A2.25 2.25 0 014.294 9.906V9m17.456 0a2.25 2.25 0 00-1.183-1.981L13.89 3.53a2.25 2.25 0 00-2.134 0L4.93 7.019A2.25 2.25 0 003.75 9m17.456 0L12 13.5 3.75 9" />
      </svg>

      <input
        type="email"
        name="email"
        placeholder={t.features.form.mail}
        class="w-full bg-transparent outline-none text-sm text-black dark:text-white placeholder-gray-400"
        required
      />
    </div>

    <!-- SUBJECT -->
    <div class="flex items-center gap-3 px-4 py-3 rounded-full border
                border-gray-300 bg-white text-black
                dark:bg-black dark:text-white dark:border-gray-700">

      <svg xmlns="http://www.w3.org/2000/svg"
        class="w-5 h-5 text-gray-500 dark:text-gray-300"
        fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
          d="M9 12h6m-6 4h6M5 6h14" />
      </svg>

      <input
        type="text"
        name="subject"
        placeholder={t.features.form.subject}
        class="w-full bg-transparent outline-none text-sm text-black dark:text-white placeholder-gray-400"
        required
      />
    </div>

    <!-- MESSAGE -->
    <textarea
      name="message"
      rows="4"
      placeholder={t.features.form.text}
      class="w-full px-4 py-3 rounded-xl border
             border-gray-300 bg-white text-black
             dark:bg-black dark:text-white dark:border-gray-700
             outline-none text-sm placeholder-gray-400"
      required
    ></textarea>

    <!-- BUTTON -->
    <Button variant={"primary"} className="w-full">
      <span class="text-white relative z-[5]">
        {t.features.form.submit}
      </span>
    </Button>

  </form>
</div>
    </div>
  </Container>
</section>