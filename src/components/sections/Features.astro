---
import Container from "../shared/Container.astro";
import Paragraph from "../shared/Paragraph.astro";
import Title from "../shared/Title.astro";
import Button from "../shared/Button.astro";
import { translations } from "../../i18n";

const { lang = "en" } = Astro.props;
const t = translations[lang];

---
<section class="pt-0 pb-0"> 
  <div class="mx-auto text-center max-w-screen-lg relative">
    <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold text-heading-1 leading-tight">
      {t.features.text}
    </h1>
  </div>
</section>
<section  id="contact" class="pb-0">
  <Container>
    <div class="w-full relative py-8 md:py-10 px-6 md:px-8 rounded-2xl bg-gradient-to-tr from-gray-100 to-gray-200 dark:from-gray-900 dark:to-transparent">
      <div class="absolute right-0 top-0 h-full w-full flex justify-end pointer-events-none">
          <div class="w-28 h-28 overflow-auto flex rounded-xl relative blur-2xl">
              <span
                class="absolute w-16 h-16 -top-1 -right-1 bg-green-500 rounded-md rotate-45"
              ></span>
              <span
                class="absolute w-16 h-16 -bottom-1 -right-1 bg-[#FCDC58] rounded-md rotate-45"
              ></span>
              <span
                class="absolute w-16 h-16 -bottom-1 -left-1 bg-primary rounded-md rotate-45"
              ></span>
          </div>
      </div>

      <div class="absolute left-0 bottom-0 h-full w-full flex items-end pointer-events-none">
        <div class="w-28 h-28 overflow-auto flex rounded-xl relative blur-2xl">
            <span
              class="absolute w-16 h-16 -top-1 -right-1 bg-green-500 rounded-md rotate-45"
            ></span>
            <span
              class="absolute w-16 h-16 -bottom-1 -right-1 bg-[#FCDC58] rounded-md rotate-45"
            ></span>
            <span
              class="absolute w-16 h-16 -bottom-1 -left-1 bg-primary rounded-md rotate-45"
            ></span>
          </div>
      </div>

      <div class="text-center max-w-3xl mx-auto space-y-4">
          <Title>
              {t.features.title}
          </Title>
      </div>
      <div class="mx-auto mt-6 flex max-w-xl items-start gap-3 rounded-xl border border-amber-400/40 bg-amber-400/10 px-4 py-3 text-left">
        <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="mt-0.5 h-5 w-5 shrink-0 text-amber-500">
          <circle cx="12" cy="12" r="9" />
          <path stroke-linecap="round" d="M12 11v5m0-8h.01" />
        </svg>
        <p class="text-sm text-heading-2">
          {t.features.unavailable}{" "}
          <a href="https://wa.me/21656825892" target="_blank" rel="noopener noreferrer" class="font-semibold text-primary underline underline-offset-2 hover:opacity-80">
            {t.features.whatsapp}
          </a>{" "}{t.features.emailIntro}{" "}
          <a href="mailto:contact.antholab@gmail.com" class="font-semibold text-primary underline underline-offset-2 hover:opacity-80">
            contact.antholab@gmail.com
          </a>.
        </p>
      </div>
      <div class="mx-auto max-w-md sm:max-w-xl pt-10">
        <form id ="contact-form" class="space-y-4 text-left relative z-10 space-y-4 text-left" action="https://formspree.io/f/xoeelzwb" method="POST">
        
          <!-- NAME -->
          <div class="flex items-center gap-3 px-4 py-3 rounded-full border border-gray-300 bg-white text-black dark:bg-black dark:text-white dark:border-gray-700">

            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-gray-500 dark:text-gray-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15.75 6.75a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.5 20.25a7.5 7.5 0 0115 0" />
            </svg>
            <input type="hidden" name="_subject" value="Nouveau message depuis ton site"/>
            <input type="hidden" name="_captcha" value="false"/>
            <input type="hidden" name="_next" value={`http://localhost:4321/AnthoLab/${lang}`}/>

            <input type="text" name="name" placeholder={t.features.form.nom} class="w-full bg-transparent outline-none text-sm text-black dark:text-white placeholder-gray-400" required/>
          </div>

          <!-- EMAIL -->
          <div class="flex items-center gap-3 px-4 py-3 rounded-full border border-gray-300 bg-white text-black dark:bg-black dark:text-white dark:border-gray-700">

            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-gray-500 dark:text-gray-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21.75 9v.906a2.25 2.25 0 01-1.183 1.981l-6.478 3.488a2.25 2.25 0 01-2.134 0L5.477 11.887A2.25 2.25 0 014.294 9.906V9m17.456 0a2.25 2.25 0 00-1.183-1.981L13.89 3.53a2.25 2.25 0 00-2.134 0L4.93 7.019A2.25 2.25 0 003.75 9m17.456 0L12 13.5 3.75 9" />
            </svg>

            <input type="email" name="email" placeholder={t.features.form.mail} class="w-full bg-transparent outline-none text-sm text-black dark:text-white placeholder-gray-400" required/>
          </div>

          <!-- SUBJECT -->
          <div class="flex items-center gap-3 px-4 py-3 rounded-full border border-gray-300 bg-white text-black dark:bg-black dark:text-white dark:border-gray-700">

            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-gray-500 dark:text-gray-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6M5 6h14" />
            </svg>

            <input type="text" name="subject" placeholder={t.features.form.subject} class="w-full bg-transparent outline-none text-sm text-black dark:text-white placeholder-gray-400" required/>
          </div>

          <!-- SELECTED SERVICE -->
          <select
            id="service-select"
            name="service"
            class="w-full px-4 py-3 rounded-full border border-box-border bg-box-bg text-heading-1 text-sm outline-none focus:border-primary">
            <option value="">{lang === "fr" ? "Service souhaité (facultatif)" : "Service (optional)"}</option>
            {t.pricing.items.map((item) => (
              <option value={item.name} data-service-key={item.key}>{item.name}</option>
            ))}
            <option value={lang === "fr" ? "Devis personnalisé" : "Custom quote"} data-service-key="quote">
              {lang === "fr" ? "Devis personnalisé" : "Custom quote"}
            </option>
          </select>

          <!-- MESSAGE -->
          <textarea name="message" rows="4" placeholder={t.features.form.text} class="w-full px-4 py-3 rounded-xl border border-gray-300 bg-white text-black dark:bg-black dark:text-white dark:border-gray-700 outline-none text-sm placeholder-gray-400" required></textarea>

          <!-- BUTTON -->
          <Button variant={"primary"} className="w-full">
            <span data-submit-content class="text-white relative z-[5]">
              {t.features.form.submit}
            </span>
            <span data-submit-indicator class="hidden relative z-[5] h-full w-full items-center justify-center" aria-hidden="true">
              <svg data-submit-spinner class="hidden h-5 w-5 animate-spin text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-90" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
              <svg data-submit-success class="hidden h-7 w-7 text-green-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path>
              </svg>
              <svg data-submit-error class="hidden h-7 w-7 text-red-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 6l12 12M18 6L6 18"></path>
              </svg>
            </span>
          </Button>
          <p id="contact-success-msg" class="hidden text-green-500" role="status">{t.features.form.success}</p>
          <div data-error-hint class="relative hidden w-fit">
            <button id="contact-error-trigger" type="button" aria-expanded="false" aria-controls="contact-error-popover" aria-label={lang === "fr" ? "Afficher le détail de l’erreur" : "Show error details"} class="rounded-full p-1 text-red-500 transition hover:bg-red-500/10 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-500">
              <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="h-5 w-5">
                <circle cx="12" cy="12" r="9"></circle>
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 11v5m0-8h.01"></path>
              </svg>
            </button>
            <div id="contact-error-popover" class="hidden absolute left-full top-1/2 z-20 ml-2 w-max -translate-y-1/2 whitespace-nowrap rounded-lg border border-red-500/20 bg-white p-3 text-left text-sm text-red-700 shadow-lg dark:bg-slate-900 dark:text-red-300" role="alert">
              {t.features.form.error}.
            </div>
          </div>
        </form>
      </div>
    </div>
  </Container>
  <script>
    const form = document.getElementById('contact-form') as HTMLFormElement;
    const successMsg = document.getElementById('contact-success-msg');
    const errorHint = form.querySelector('[data-error-hint]') as HTMLElement | null;
    const errorTrigger = document.getElementById('contact-error-trigger') as HTMLButtonElement | null;
    const errorPopover = document.getElementById('contact-error-popover');
    const submitButton = form.querySelector('button') as HTMLButtonElement;
    const submitContent = submitButton.querySelector('[data-submit-content]');
    const submitIndicator = submitButton.querySelector('[data-submit-indicator]');
    const spinner = submitButton.querySelector('[data-submit-spinner]');
    const successIcon = submitButton.querySelector('[data-submit-success]');
    const errorIcon = submitButton.querySelector('[data-submit-error]');
    const originalLabel = submitButton.innerText.trim();

    const hideErrorHint = () => {
      errorPopover?.classList.add('hidden');
      errorTrigger?.setAttribute('aria-expanded', 'false');
    };

    errorTrigger?.addEventListener('click', (event) => {
      event.stopPropagation();
      const isOpen = errorTrigger.getAttribute('aria-expanded') === 'true';
      errorPopover?.classList.toggle('hidden', isOpen);
      errorTrigger.setAttribute('aria-expanded', String(!isOpen));
    });

    document.addEventListener('click', (event) => {
      if (!errorHint?.contains(event.target as Node)) hideErrorHint();
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') hideErrorHint();
    });

    const setButtonState = (state: 'loading' | 'success' | 'error' | 'idle') => {
      if (submitContent) submitContent.style.display = state === 'idle' ? '' : 'none';
      if (submitIndicator) submitIndicator.style.display = state === 'idle' ? 'none' : 'flex';
      if (spinner) spinner.style.display = state === 'loading' ? 'block' : 'none';
      if (successIcon) successIcon.style.display = state === 'success' ? 'block' : 'none';
      if (errorIcon) errorIcon.style.display = state === 'error' ? 'block' : 'none';
      submitButton.style.width = state === 'idle' ? '' : '3rem';
      submitButton.style.height = state === 'idle' ? '' : '3rem';
      submitButton.style.minWidth = state === 'idle' ? '' : '0';
      submitButton.style.padding = state === 'idle' ? '' : '0';
      submitButton.style.display = state === 'idle' ? '' : 'flex';
      submitButton.style.alignItems = state === 'idle' ? '' : 'center';
      submitButton.style.justifyContent = state === 'idle' ? '' : 'center';
      submitButton.style.marginInline = state === 'idle' ? '' : 'auto';
      submitButton.setAttribute('aria-label', state === 'idle' ? originalLabel : state === 'loading' ? 'Sending' : state === 'success' ? 'Sent successfully' : 'Sending failed');
      submitButton.disabled = state === 'loading' || state === 'success';
    };

    const serviceParam = new URLSearchParams(window.location.search).get("service");
    const serviceSelect = document.getElementById('service-select') as HTMLSelectElement | null;
    const selectedServiceOption = serviceSelect && serviceParam
      ? Array.from(serviceSelect.options).find((option) => option.dataset.serviceKey === serviceParam)
      : undefined;
    if (serviceSelect && selectedServiceOption) {
      serviceSelect.value = selectedServiceOption.value;
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      successMsg?.classList.add('hidden');
      errorHint?.classList.add('hidden');
      hideErrorHint();
      setButtonState('loading');

      const data = new FormData(form);

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: data,
          headers: { 'Accept': 'application/json' }
        });

        if (response.ok) {
          form.reset();
          setButtonState('success');
          window.setTimeout(() => setButtonState('idle'), 6000);
        } else {
          errorHint?.classList.remove('hidden');
          setButtonState('error');
          window.setTimeout(() => {
            hideErrorHint();
            errorHint?.classList.add('hidden');
            setButtonState('idle');
          }, 6000);
        }
      } catch {
        errorHint?.classList.remove('hidden');
        setButtonState('error');
        window.setTimeout(() => {
          hideErrorHint();
          errorHint?.classList.add('hidden');
          setButtonState('idle');
        }, 6000);
      }
    });
  </script>
</section>
