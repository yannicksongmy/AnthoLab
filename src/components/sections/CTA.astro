---
import Button from "../shared/Button.astro";
import Container from "../shared/Container.astro";
import Paragraph from "../shared/Paragraph.astro";
import { translations } from "../../i18n";

const { lang = "en" } = Astro.props;
const t = translations[lang];
---

<section  id="cta" class="pb-5 overflow-hidden">
  <Container>
    <div
      class="w-full relative py-8 md:py-10 px-6 md:px-8 rounded-2xl bg-gradient-to-tr from-gray-100 to-gray-200 dark:from-gray-900 dark:to-transparent overflow-hidden" 
    >
      <div class="absolute right-0 top-0 pointer-events-none">
        <div class="w-28 h-28 flex rounded-xl relative blur-2xl">
            <span
              class="absolute w-16 h-16 -top-1 -right-1 bg-green-500 rounded-md rotate-45"
            ></span>
            <span
              class="absolute w-16 h-16 -bottom-1 -right-1 bg-[#FCDC58] rounded-md rotate-45"
            ></span>
            <span
              class="absolute w-16 h-16 -bottom-1 -left-1 bg-primary rounded-md rotate-45"
            ></span>
          </div>
      </div>

      <div class="absolute left-0 bottom-0 pointer-events-none">
        <div class="w-28 h-28 flex rounded-xl relative blur-2xl">
            <span
              class="absolute w-16 h-16 -top-1 -right-1 bg-green-500 rounded-md rotate-45"
            ></span>
            <span
              class="absolute w-16 h-16 -bottom-1 -right-1 bg-[#FCDC58] rounded-md rotate-45"
            ></span>
            <span
              class="absolute w-16 h-16 -bottom-1 -left-1 bg-primary rounded-md rotate-45"
            ></span>
          </div>
      </div>
      <div class="mx-auto text-center max-w-xl md:max-w-2xl relative">
        <h1 class="text-3xl/tight sm:text-4xl/tight md:text-5xl/tight font-bold text-heading-1" >
          {t.cta.t1} <span class="inline-block bg-clip-text text-transparent bg-gradient-to-br from-indigo-600 via-primary to-green-600">{t.cta.t2}</span> {t.cta.t3}
        </h1>
        <Paragraph className={"pt-10"}>
          {t.cta.description}
        </Paragraph>
        <div class="mx-auto max-w-md sm:max-w-xl pt-10">
          <a href="https://wa.me/21656825892" target="_blank" rel="noopener noreferrer" class="transition hover:text-heading-1 hover:scale-105">
          <Button variant={"primary"}>
              <span class="text-white relative z-[5]">{t.cta.okay}</span>
          </Button>
          </a>
        </div>
      </div>
    </div>
  </Container>
</section>

