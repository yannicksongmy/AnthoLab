---
import Button from "../shared/Button.astro";
import Container from "../shared/Container.astro";
import Paragraph from "../shared/Paragraph.astro";
import ByNumber from "./ByNumber.astro";
import { translations } from "../../i18n";

const { lang = "en" } = Astro.props;
const t = translations[lang];

---

<section class="relative isolate pt-32 pb-12 lg:pt-36">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-full overflow-hidden">
        <img
            src={`${import.meta.env.BASE_URL}images/image.png`}
            alt=""
            class="absolute inset-x-0 top-0 h-[clamp(17rem,72vw,23rem)] w-full object-cover object-[62%_center] [mask-image:linear-gradient(to_bottom,black_38%,transparent_100%)] sm:inset-0 sm:h-full sm:object-center sm:[mask-image:linear-gradient(to_bottom,black_62%,transparent_88%)]"
        />
        <div class="absolute inset-0 bg-gradient-to-r from-white/90 via-white/65 to-white/10 dark:from-slate-950/85 dark:via-slate-950/65 dark:to-slate-950/10"></div>
        <div class="absolute inset-0" style="background: linear-gradient(to bottom, transparent 0%, transparent 62%, rgb(var(--color-bg) / 0.9) 88%, rgb(var(--color-bg)) 100%);"></div>
        <div class="absolute inset-x-0 bottom-0 h-56 backdrop-blur-md [mask-image:linear-gradient(to_bottom,transparent,black_35%)]" style="background-color: rgb(var(--color-bg) / 0.45);"></div>
    </div>

    <Container className={"flex flex-col gap-10 lg:gap-12"}>
        <div class="relative flex flex-col items-center text-center py-7 xl:py-8 max-w-3xl mx-auto">
            
            <h1 class="text-3xl/tight sm:text-4xl/tight md:text-5xl/tight xl:text-6xl/tight
             font-bold text-heading-1">
             Antho<span class="inline-block text-transparent bg-clip-text bg-gradient-to-br from-indigo-600 from-20% via-primary via-30% to-green-600">Lab</span> {t.hero.title}
            </h1>
            <Paragraph className="mt-8 bold">
                {t.hero.description}
            </Paragraph>
            <div class="mt-10 flex-col w-full flex max-w-md mx-auto lg:mx-0">
                <div class="flex sm:flex-row flex-col gap-5 w-full">
                    <form action="https://formspree.io/f/mgaazbyb" method="POST" id="subscribe" class="py-1 pl-6 w-full pr-1 flex gap-3 items-center text-heading-3 shadow-lg shadow-box-shadow border border-box-border bg-box-bg rounded-full ease-linear focus-within:bg-body  focus-within:border-primary">
                        <span class="min-w-max pr-2 border-r border-box-border">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 9v.906a2.25 2.25 0 01-1.183 1.981l-6.478 3.488M2.25 9v.906a2.25 2.25 0 001.183 1.981l6.478 3.488m8.839 2.51l-4.66-2.51m0 0l-1.023-.55a2.25 2.25 0 00-2.134 0l-1.022.55m0 0l-4.661 2.51m16.5 1.615a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V8.844a2.25 2.25 0 011.183-1.98l7.5-4.04a2.25 2.25 0 012.134 0l7.5 4.04a2.25 2.25 0 011.183 1.98V19.5z" />
                            </svg>                                                                  
                        </span>
                        <input type="email" name="email" id="" placeholder={t.hero.placeholder}class="w-full py-3 outline-none bg-transparent">
                        <Button variant={"primary"} className={"min-w-max text-white"}>
                            <span data-submit-content class="hidden sm:flex relative z-[5]">
                                {t.hero.button1}
                            </span>
                            <span data-submit-content class="flex sm:hidden relative z-[5]">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.27 20.876L5.999 12zm0 0h7.5" />
                                </svg>                                      
                            </span>
                            <span data-submit-indicator class="hidden relative z-[5] h-full w-full items-center justify-center" aria-hidden="true">
                                <svg data-submit-spinner class="hidden h-5 w-5 animate-spin" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                    <path class="opacity-90" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                                </svg>
                                <svg data-submit-success class="hidden h-7 w-7 text-green-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path>
                                </svg>
                                <svg data-submit-error class="hidden h-7 w-7 text-red-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 6l12 12M18 6L6 18"></path>
                                </svg>
                            </span>
                        </Button>
                    </form>
                </div>
                <p id="subscribe-success-msg" class="hidden text-green-500" role="status">{t.hero.send}</p>
                <div data-error-hint class="relative mt-2 hidden w-fit">
                    <button id="subscribe-error-trigger" type="button" aria-expanded="false" aria-controls="subscribe-error-popover" aria-label={lang === "fr" ? "Afficher le détail de l’erreur" : "Show error details"} class="rounded-full p-1 text-red-500 transition hover:bg-red-500/10 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-500">
                        <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="h-5 w-5">
                            <circle cx="12" cy="12" r="9"></circle>
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 11v5m0-8h.01"></path>
                        </svg>
                    </button>
                    <div id="subscribe-error-popover" class="hidden absolute left-full top-1/2 z-20 ml-2 w-max -translate-y-1/2 whitespace-nowrap rounded-lg border border-red-500/20 bg-white p-3 text-left text-sm text-red-700 shadow-lg dark:bg-slate-900 dark:text-red-300" role="alert">
                        {t.hero.error}.
                    </div>
                </div>
            </div>
        </div>

    </Container>

    <ByNumber lang={lang} />
    <script>
    const form = document.getElementById('subscribe') as HTMLFormElement;
    const successMsg = document.getElementById('subscribe-success-msg');
    const errorHint = form.parentElement?.parentElement?.querySelector('[data-error-hint]') as HTMLElement | null;
    const errorTrigger = document.getElementById('subscribe-error-trigger') as HTMLButtonElement | null;
    const errorPopover = document.getElementById('subscribe-error-popover');
    const submitButton = form.querySelector('button') as HTMLButtonElement;
    const submitContent = submitButton.querySelectorAll('[data-submit-content]');
    const submitIndicator = submitButton.querySelector('[data-submit-indicator]');
    const spinner = submitButton.querySelector('[data-submit-spinner]');
    const successIcon = submitButton.querySelector('[data-submit-success]');
    const errorIcon = submitButton.querySelector('[data-submit-error]');
    const originalLabel = submitButton.innerText.trim();

    const hideErrorHint = () => {
      errorPopover?.classList.add('hidden');
      errorTrigger?.setAttribute('aria-expanded', 'false');
    };

    errorTrigger?.addEventListener('click', (event) => {
      event.stopPropagation();
      const isOpen = errorTrigger.getAttribute('aria-expanded') === 'true';
      errorPopover?.classList.toggle('hidden', isOpen);
      errorTrigger.setAttribute('aria-expanded', String(!isOpen));
    });

    document.addEventListener('click', (event) => {
      if (!errorHint?.contains(event.target as Node)) hideErrorHint();
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') hideErrorHint();
    });

    const setButtonState = (state: 'loading' | 'success' | 'error' | 'idle') => {
      submitContent.forEach((content) => {
        (content as HTMLElement).style.display = state === 'idle' ? '' : 'none';
      });
      if (submitIndicator) submitIndicator.style.display = state === 'idle' ? 'none' : 'flex';
      if (spinner) spinner.style.display = state === 'loading' ? 'block' : 'none';
      if (successIcon) successIcon.style.display = state === 'success' ? 'block' : 'none';
      if (errorIcon) errorIcon.style.display = state === 'error' ? 'block' : 'none';
      submitButton.style.width = state === 'idle' ? '' : '3rem';
      submitButton.style.height = state === 'idle' ? '' : '3rem';
      submitButton.style.minWidth = state === 'idle' ? '' : '0';
      submitButton.style.padding = state === 'idle' ? '' : '0';
      submitButton.style.display = state === 'idle' ? '' : 'flex';
      submitButton.style.alignItems = state === 'idle' ? '' : 'center';
      submitButton.style.justifyContent = state === 'idle' ? '' : 'center';
      submitButton.setAttribute('aria-label', state === 'idle' ? originalLabel : state === 'loading' ? 'Sending' : state === 'success' ? 'Sent successfully' : 'Sending failed');
      submitButton.disabled = state === 'loading' || state === 'success';
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      successMsg?.classList.add('hidden');
      errorHint?.classList.add('hidden');
      hideErrorHint();
      setButtonState('loading');

      const data = new FormData(form);

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: data,
          headers: { 'Accept': 'application/json' }
        });

        if (response.ok) {
          form.reset();
          setButtonState('success');
          window.setTimeout(() => setButtonState('idle'), 6000);
        } else {
          errorHint?.classList.remove('hidden');
          setButtonState('error');
          window.setTimeout(() => {
            hideErrorHint();
            errorHint?.classList.add('hidden');
            setButtonState('idle');
          }, 6000);
        }
      } catch {
        errorHint?.classList.remove('hidden');
        setButtonState('error');
        window.setTimeout(() => {
          hideErrorHint();
          errorHint?.classList.add('hidden');
          setButtonState('idle');
        }, 6000);
      }
    });
  </script>
</section>
