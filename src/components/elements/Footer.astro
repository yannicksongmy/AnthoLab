---
import GroupFooterNav from "../blocks/GroupFooterNav.astro";
import Container from "../shared/Container.astro";
import FooterNav from "../shared/FooterNav.astro";
import Paragraph from "../shared/Paragraph.astro";
import { translations } from "../../i18n";

const { lang = "en" } = Astro.props;
const t = translations[lang];
const base = import.meta.env.BASE_URL;
const footerNav1 = [
    {
        itemText:t.footer.Solutions.consulting,
        itemLink:`${base}/${lang}#services`
    },
    {
        itemText:t.footer.Solutions.design,
        itemLink:`${base}/${lang}#services`
    },
    {
        itemText:t.footer.Solutions.writing,
        itemLink:`${base}/${lang}#services`
    }
]

const footerSupport = [
    {
        itemText:t.footer.Support.faq,
        itemLink:`${base}/${lang}/faq`
    },
    {
        itemText:t.footer.Support.contact,
        itemLink:`${base}/${lang}#cta`
    }
]

const footerCompany = [
    {
        itemText:t.footer.Company.about,
        itemLink:`${base}/${lang}#about-us`
    },
    {
        itemText:t.footer.Company.services,
        itemLink:`${base}/${lang}#services`
    },
    {
        itemText:t.footer.Company.blogs,
        itemLink:`${base}/${lang}/history`
    }
]
const footerLegal = [
    {
        itemText:t.footer.Legal.claim,
        itemLink:`${base}/${lang}/legal`
    },
    {
        itemText:t.footer.Legal.privacy,
        itemLink:`${base}/${lang}/privacy`
    },
    {
        itemText:t.footer.Legal.terms,
        itemLink:`${base}/${lang}/terms`
    }
]
---
<div class="mt-16"></div>
<footer class="relative bg-gradient-to-tr from-gray-100 to-gray-200 dark:from-gray-900 dark:to-transparent pt-20 pl-0 rounded-t-3xl">
    <div class="absolute right-0 top-0 h-full w-full flex justify-end">
        <div class="w-28 h-28 overflow-auto flex rounded-xl relative blur-2xl">
            <span
              class="absolute w-16 h-16 -top-1 -right-1 bg-green-500 rounded-md rotate-45"
            ></span>
            <span
              class="absolute w-16 h-16 -bottom-1 -right-1 bg-[#FCDC58] rounded-md rotate-45"
            ></span>
            <span
              class="absolute w-16 h-16 -bottom-1 -left-1 bg-primary rounded-md rotate-45"
            ></span>
          </div>
      </div>

      <div class="absolute left-0 bottom-0 h-full w-full flex items-end">
        <div class="w-28 h-28 overflow-auto flex rounded-xl relative blur-2xl">
            <span
              class="absolute w-16 h-16 -top-1 -right-1 bg-green-500 rounded-md rotate-45"
            ></span>
            <span
              class="absolute w-16 h-16 -bottom-1 -right-1 bg-[#FCDC58] rounded-md rotate-45"
            ></span>
            <span
              class="absolute w-16 h-16 -bottom-1 -left-1 bg-primary rounded-md rotate-45"
            ></span>
          </div>
      </div>
    <Container className="pb-8 ml-0 relative overflow-auto">
        
        <span class="absolute top-1/2 left-1/2 -translate-y-1/2 -translate-x-1/2 blur-2xl opacity-20 w-24 h-16 sm:w-48 sm:h-36 rounded-full rotate-12 skew-x-6 bg-primary"></span>
        <div class="grid grid-cols-2 lg:grid-cols-3 lg:items-stretch relative">
            <div class="col-span-2 lg:col-span-1 h-auto flex flex-col items-center">
                <div >
                    <a href={`${import.meta.env.BASE_URL}/${lang}`} class="relative flex items-start gap-3">
                        <img 
                            src={`${import.meta.env.BASE_URL}/logos/logo.png`} 
                            alt="AnthoLab Solutions" 
                            class="h-45 w-auto"
                        />
                        <!--<div class="inline-flex text-2xl font-semibold text-heading-1">
                            Antho<span class="text-primary">Lab</span>
                        </div>-->
                    </a>
                    <!--<Paragraph className={"mt-0 !text-sm"}>
                        {t.footer.description}
                    </Paragraph>-->
                </div>
            </div>

            <GroupFooterNav>
                <FooterNav title={t.footer.Company.title} navItems={footerCompany}/>
                <FooterNav title={t.footer.Support.title} navItems={footerSupport}/>
            </GroupFooterNav>

            <GroupFooterNav>
                <FooterNav title={t.footer.Legal.title} navItems={footerLegal}/>
                <div class="space-y-0 md:space-y-6">
                    <button class="footer-nav-btn w-full flex justify-between items-center py-3 md:py-0 border-b border-box-border md:border-0 text-left">
                        <h3 class="capitalize font-semibold text-heading-1 text-xl">{t.footer.Solutions.title}</h3>
                        <svg class="footer-nav-icon w-5 h-5 transition-transform duration-300 md:hidden" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                        </svg>
                    </button>
                    <div class="footer-nav-list hidden md:block pt-3 md:pt-0">
                        <div class="flex flex-col gap-3">
                            <div class="flex gap-3 text-heading-2">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-primary flex-shrink-0">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
                                </svg>
                                <a href="mailto:contact.antholab@gmail.com" class="text-sm hover:text-primary transition">
                                    contact.antholab@gmail.com
                                </a>
                            </div>

                            <div class="flex gap-3 text-heading-2">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-primary flex-shrink-0">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 6.75z" />
                                </svg>
                                <a href="tel:+21656825892" class="text-sm hover:text-primary transition">
                                    +216 56 825 892
                                </a>
                            </div>

                            <div class="flex gap-3 text-heading-2">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-primary flex-shrink-0">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
                                </svg>
                                <span class="text-sm">{t.footer.location}</span>
                            </div>
                        </div>
                    </div>
                </div>
            </GroupFooterNav>
        </div>
    </Container>
    <!-- social links -->
                    <div class="flex items-center justify-center md:text-right w-full gap-4 text-heading-3 mt-2 relative z-10 pointer-events-auto">
                        <a href="https://www.facebook.com/share/17aW63Qbx9/?mibextid=wwXIfr" target="_blank" class="transition hover:text-heading-1 hover:scale-105">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="w-5 h-5" viewBox="0 0 16 16">
                                <path d="M16 8.049c0-4.446-3.582-8.05-8-8.05C3.58 0-.002 3.603-.002 8.05c0 4.017 2.926 7.347 6.75 7.951v-5.625h-2.03V8.05H6.75V6.275c0-2.017 1.195-3.131 3.022-3.131.876 0 1.791.157 1.791.157v1.98h-1.009c-.993 0-1.303.621-1.303 1.258v1.51h2.218l-.354 2.326H9.25V16c3.824-.604 6.75-3.934 6.75-7.951z"/>
                            </svg>
                            <span class="sr-only">social link</span>
                        </a>

                        <a href="https://www.linkedin.com/company/antholab-solutions/" target="_blank" class="transition hover:text-heading-1 hover:scale-105">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="w-5 h-5" viewBox="0 0 16 16">
                                <path d="M0 1.146C0 .513.526 0 1.175 0h13.65C15.474 0 16 .513 16 1.146v13.708c0 .633-.526 1.146-1.175 1.146H1.175C.526 16 0 15.487 0 14.854V1.146zm4.943 12.248V6.169H2.542v7.225h2.401zm-1.2-8.212c.837 0 1.358-.554 1.358-1.248-.015-.709-.52-1.248-1.342-1.248-.822 0-1.359.54-1.359 1.248 0 .694.521 1.248 1.327 1.248h.016zm4.908 8.212V9.359c0-.216.016-.432.08-.586.173-.431.568-.878 1.232-.878.869 0 1.216.662 1.216 1.634v3.865h2.401V9.25c0-2.22-1.184-3.252-2.764-3.252-1.274 0-1.845.7-2.165 1.193v.025h-.016a5.54 5.54 0 0 1 .016-.025V6.169h-2.4c.03.678 0 7.225 0 7.225h2.4z"/>
                            </svg>
                            <span class="sr-only">social link</span>
                        </a>

                        <a href="#" class="transition hover:text-heading-1 hover:scale-105">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="w-5 h-5" viewBox="0 0 16 16">
                                <path d="M5.026 15c6.038 0 9.341-5.003 9.341-9.334 0-.14 0-.282-.006-.422A6.685 6.685 0 0 0 16 3.542a6.658 6.658 0 0 1-1.889.518 3.301 3.301 0 0 0 1.447-1.817 6.533 6.533 0 0 1-2.087.793A3.286 3.286 0 0 0 7.875 6.03a9.325 9.325 0 0 1-6.767-3.429 3.289 3.289 0 0 0 1.018 4.382A3.323 3.323 0 0 1 .64 6.575v.045a3.288 3.288 0 0 0 2.632 3.218 3.203 3.203 0 0 1-.865.115 3.23 3.23 0 0 1-.614-.057 3.283 3.283 0 0 0 3.067 2.277A6.588 6.588 0 0 1 .78 13.58a6.32 6.32 0 0 1-.78-.045A9.344 9.344 0 0 0 5.026 15z"/>
                            </svg>
                            <span class="sr-only">social link</span>
                        </a>

                        <a href="https://wa.me/21656825892" target="_blank" rel="noopener noreferrer" class="transition hover:text-heading-1 hover:scale-105">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="w-5 h-5 shrink-0 fill-current" viewBox="0 0 32 32">
                                <path d="M16.001 2.003c-7.72 0-13.998 6.278-13.998 13.999 0 2.474.648 4.885 1.88 6.994L2 30l7.188-1.885a13.9 13.9 0 006.813 1.738h.001c7.72 0 13.998-6.278 13.998-13.999S23.72 2.003 16.001 2.003zm0 25.5a11.44 11.44 0 01-5.84-1.59l-.418-.25-4.266 1.12 1.14-4.16-.272-.427a11.47 11.47 0 01-1.772-6.193c0-6.337 5.154-11.491 11.49-11.491s11.49 5.154 11.49 11.49-5.154 11.491-11.49 11.491zm6.287-8.568c-.344-.172-2.035-1.004-2.35-1.118-.315-.114-.544-.172-.772.172-.229.344-.886 1.118-1.087 1.346-.2.229-.401.258-.745.086-.344-.172-1.452-.535-2.765-1.706-1.022-.912-1.713-2.037-1.915-2.381-.201-.344-.022-.53.151-.702.155-.155.344-.401.516-.601.172-.2.229-.344.344-.573.115-.229.057-.43-.029-.601-.086-.172-.772-1.861-1.058-2.549-.279-.669-.562-.579-.772-.59l-.658-.012c-.229 0-.601.086-.915.43s-1.201 1.173-1.201 2.86 1.23 3.32 1.401 3.549c.172.229 2.421 3.697 5.861 5.184.819.353 1.459.565 1.958.723.823.262 1.571.225 2.162.136.66-.098 2.035-.831 2.321-1.635.287-.803.287-1.491.201-1.635-.086-.143-.315-.229-.658-.401z"/>
                            </svg>
                            <span class="sr-only">social link</span>
                        </a>
                    </div>
   <div class="bg-gradient-to-tl from-box-bg py-2 relative">
  <Container>
    <div class="flex flex-col sm:flex-row justify-center items-center gap-2 sm:gap-6">
      
      <div class="text-sm text-heading-3 whitespace-nowrap">
        &copy; <span id="year"></span> AnthoLab Solutions. {t.footer.copyright}
      </div>

      <script>
        document.getElementById("year").textContent = new Date().getFullYear();
      </script>

      <div class="text-sm text-heading-3 whitespace-nowrap text-center">
        {t.footer.author}<a href="https://github.com/johnkat-mj" target="_blank" class="font-semibold">John Kat</a> • {t.footer.site} <a href="https://themewagon.com" target="_blank" class="font-semibold">ThemeWagon</a>
      </div>

    </div>
  </Container>
</div>
</footer>
